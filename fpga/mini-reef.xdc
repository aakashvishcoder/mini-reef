# Mini-Reef pin constraints for XC7A15T-1FTG256C (XC7A35T is pin-compatible).
# Generated by fpga/gen_xdc.py from the KiCad netlist. Regenerate if the schematic changes.

# Configuration: bank 0 and bank 14 are 3.3 V, boot is Master SPI x4 from the W25Q32.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]

# 50 MHz clock (bank 14, MRCC)
set_property -dict {PACKAGE_PIN N11 IOSTANDARD LVCMOS33} [get_ports {clk50}]  ;# IO_L13P_T2_MRCC_14
create_clock -name clk50 -period 20.000 [get_ports {clk50}]

# HyperRAM, HyperBus (bank 35, byte group T1, 1.8 V)
set_property -dict {PACKAGE_PIN E3  IOSTANDARD LVCMOS18} [get_ports {hr_ck}]  ;# IO_L11P_T1_SRCC_35
set_property -dict {PACKAGE_PIN D3  IOSTANDARD LVCMOS18} [get_ports {hr_ck_n}]  ;# IO_L11N_T1_SRCC_35
set_property -dict {PACKAGE_PIN C4  IOSTANDARD LVCMOS18} [get_ports {hr_cs_n}]  ;# IO_L12N_T1_MRCC_35
set_property -dict {PACKAGE_PIN D4  IOSTANDARD LVCMOS18} [get_ports {hr_rwds}]  ;# IO_L12P_T1_MRCC_35
set_property -dict {PACKAGE_PIN G5  IOSTANDARD LVCMOS18} [get_ports {hr_rst_n}]  ;# IO_L16P_T2_35
set_property -dict {PACKAGE_PIN C3  IOSTANDARD LVCMOS18} [get_ports {hr_dq[0]}]  ;# IO_L7P_T1_AD6P_35
set_property -dict {PACKAGE_PIN C2  IOSTANDARD LVCMOS18} [get_ports {hr_dq[1]}]  ;# IO_L7N_T1_AD6N_35
set_property -dict {PACKAGE_PIN B2  IOSTANDARD LVCMOS18} [get_ports {hr_dq[2]}]  ;# IO_L8P_T1_AD14P_35
set_property -dict {PACKAGE_PIN A2  IOSTANDARD LVCMOS18} [get_ports {hr_dq[3]}]  ;# IO_L8N_T1_AD14N_35
set_property -dict {PACKAGE_PIN C1  IOSTANDARD LVCMOS18} [get_ports {hr_dq[4]}]  ;# IO_L9P_T1_DQS_AD7P_35
set_property -dict {PACKAGE_PIN B1  IOSTANDARD LVCMOS18} [get_ports {hr_dq[5]}]  ;# IO_L9N_T1_DQS_AD7N_35
set_property -dict {PACKAGE_PIN E2  IOSTANDARD LVCMOS18} [get_ports {hr_dq[6]}]  ;# IO_L10P_T1_AD15P_35
set_property -dict {PACKAGE_PIN D1  IOSTANDARD LVCMOS18} [get_ports {hr_dq[7]}]  ;# IO_L10N_T1_AD15N_35

# Console UART to CH347T (bank 14). Named from the FPGA side.
set_property -dict {PACKAGE_PIN T9  IOSTANDARD LVCMOS33} [get_ports {uart_tx}]  ;# IO_L22P_T3_A05_D21_14
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33} [get_ports {uart_rx}]  ;# IO_L22N_T3_A04_D20_14

# Test host link to the CH32V307 board, J3 (bank 15)
set_property -dict {PACKAGE_PIN A8  IOSTANDARD LVCMOS33} [get_ports {host_sck}]  ;# IO_L2P_T0_AD8P_15
set_property -dict {PACKAGE_PIN A9  IOSTANDARD LVCMOS33} [get_ports {host_mosi}]  ;# IO_L2N_T0_AD8N_15
set_property -dict {PACKAGE_PIN A10 IOSTANDARD LVCMOS33} [get_ports {host_miso}]  ;# IO_L3N_T0_DQS_AD1N_15
set_property -dict {PACKAGE_PIN A12 IOSTANDARD LVCMOS33} [get_ports {host_cs_n}]  ;# IO_L5N_T0_AD9N_15
set_property -dict {PACKAGE_PIN A13 IOSTANDARD LVCMOS33} [get_ports {host_rst_n}]  ;# IO_L7P_T1_AD2P_15
set_property -dict {PACKAGE_PIN A14 IOSTANDARD LVCMOS33} [get_ports {host_start}]  ;# IO_L7N_T1_AD2N_15
set_property -dict {PACKAGE_PIN A15 IOSTANDARD LVCMOS33} [get_ports {host_done}]  ;# IO_L9N_T1_DQS_AD3N_15
set_property -dict {PACKAGE_PIN B16 IOSTANDARD LVCMOS33} [get_ports {host_pass}]  ;# IO_L10N_T1_AD11N_15

# Debug header J4 (bank 34)
set_property -dict {PACKAGE_PIN M1  IOSTANDARD LVCMOS33} [get_ports {dbg[0]}]  ;# IO_L2N_T0_34
set_property -dict {PACKAGE_PIN N1  IOSTANDARD LVCMOS33} [get_ports {dbg[1]}]  ;# IO_L4P_T0_34
set_property -dict {PACKAGE_PIN P1  IOSTANDARD LVCMOS33} [get_ports {dbg[2]}]  ;# IO_L4N_T0_34
set_property -dict {PACKAGE_PIN R1  IOSTANDARD LVCMOS33} [get_ports {dbg[3]}]  ;# IO_L7N_T1_34
set_property -dict {PACKAGE_PIN R2  IOSTANDARD LVCMOS33} [get_ports {dbg[4]}]  ;# IO_L7P_T1_34
set_property -dict {PACKAGE_PIN T2  IOSTANDARD LVCMOS33} [get_ports {dbg[5]}]  ;# IO_L8N_T1_34
set_property -dict {PACKAGE_PIN T3  IOSTANDARD LVCMOS33} [get_ports {dbg[6]}]  ;# IO_L9N_T1_DQS_34
set_property -dict {PACKAGE_PIN T4  IOSTANDARD LVCMOS33} [get_ports {dbg[7]}]  ;# IO_L9P_T1_DQS_34

# User LEDs (active high) and button (active low, external 4.7k pull-up), bank 15
set_property -dict {PACKAGE_PIN C16 IOSTANDARD LVCMOS33} [get_ports {led[0]}]  ;# IO_L10P_T1_AD11P_15
set_property -dict {PACKAGE_PIN D16 IOSTANDARD LVCMOS33} [get_ports {led[1]}]  ;# IO_L17N_T2_A25_15
set_property -dict {PACKAGE_PIN E16 IOSTANDARD LVCMOS33} [get_ports {btn_n}]  ;# IO_L17P_T2_A26_15

# Config flash data pins (bank 14). Only needed if your design reads the flash after
# configuration. FLASH_CLK is CCLK: reach it through the STARTUPE2 primitive, not a port.
# set_property -dict {PACKAGE_PIN L12 IOSTANDARD LVCMOS33} [get_ports {flash_cs_n}]  ;# IO_L6P_T0_FCS_B_14
# set_property -dict {PACKAGE_PIN J13 IOSTANDARD LVCMOS33} [get_ports {flash_dq[0]}]  ;# IO_L1P_T0_D00_MOSI_14
# set_property -dict {PACKAGE_PIN J14 IOSTANDARD LVCMOS33} [get_ports {flash_dq[1]}]  ;# IO_L1N_T0_D01_DIN_14
# set_property -dict {PACKAGE_PIN K15 IOSTANDARD LVCMOS33} [get_ports {flash_dq[2]}]  ;# IO_L2P_T0_D02_14
# set_property -dict {PACKAGE_PIN K16 IOSTANDARD LVCMOS33} [get_ports {flash_dq[3]}]  ;# IO_L2N_T0_D03_14

